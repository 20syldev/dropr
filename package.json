{
    "version": "4.0.0-pre",
    "name": "dropr",
    "description": "A self-hosted CDN that stores, versions and serves scripts and packages, as a command line and a library",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "bin": {
        "dropr": "./dist/bin.js"
    },
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "scripts": {
        "dev": "tsx watch src/bin.ts serve",
        "start": "node dist/bin.js serve",
        "build": "tsc",
        "prepack": "tsc",
        "prepublishOnly": "npm run check && npm test",
        "test": "tsc && node --test \"test/*.test.mjs\"",
        "test:update": "tsc && node --test --test-update-snapshots test/routes.test.mjs",
        "check": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && eslint src/ test/ && prettier --check src/ test/",
        "format": "prettier --write src/ test/ && eslint --fix src/ test/",
        "upgrade:minor": "npm upgrade",
        "upgrade:major": "npx npm-check-updates -u && npm install"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@20syldev/logger.ts": "^1.0.1",
        "@moxon/limiter": "^1.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.5.0",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "npm-check-updates": "^23.1.1",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.2"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/20syldev/dropr.git"
    },
    "keywords": [
        "cdn",
        "self-hosted",
        "versioning",
        "packages",
        "server"
    ],
    "author": "Sylvain L.",
    "license": "BSD-3-Clause",
    "bugs": {
        "url": "https://github.com/20syldev/dropr/issues"
    },
    "homepage": "https://github.com/20syldev/dropr",
    "overrides": {
        "minimatch": "^11.0.1"
    }
}
