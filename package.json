{
    "version": "3.3.1",
    "name": "@20syldev/dropr",
    "description": "dropr, a self-hosted CDN to store, version and distribute scripts and packages",
    "main": "dist/app.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/app.ts",
        "start": "node dist/app.js",
        "build": "tsc",
        "test": "tsc && node --test \"test/*.test.mjs\"",
        "test:update": "tsc && node --test --test-update-snapshots \"test/*.test.mjs\"",
        "fetch": "bash scripts/fetch.sh",
        "check": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && eslint src/ scripts/ test/ && prettier --check src/ scripts/ test/",
        "format": "prettier --write src/ scripts/ test/ && eslint --fix src/ scripts/ test/",
        "upgrade:minor": "npm upgrade",
        "upgrade:major": "npx npm-check-updates -u && npm install"
    },
    "dependencies": {
        "@20syldev/logger.ts": "^1.0.1",
        "cors": "^2.8.6",
        "express": "^5.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.5.0",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "npm-check-updates": "^23.1.1",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/20syldev/dropr.git"
    },
    "keywords": [
        "cdn",
        "express",
        "utility"
    ],
    "author": "Sylvain L.",
    "license": "BSD-3-Clause",
    "bugs": {
        "url": "https://github.com/20syldev/dropr/issues"
    },
    "homepage": "https://dropr.sylvain.sh"
}
