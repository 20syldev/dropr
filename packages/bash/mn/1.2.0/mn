#!/bin/bash
# =========================================================
# MN - Personal Dynamic Manual
# Author: 20syldev
# =========================================================

MN_DIR="$HOME/.config/mn"
VERSION="$(cat "$MN_DIR/VERSION")"

# Load libraries
source "$MN_DIR/lib/core.sh"
source "$MN_DIR/lib/dat.sh"
source "$MN_DIR/lib/module.sh"
source "$MN_DIR/lib/crud.sh"
source "$MN_DIR/lib/ui.sh"
source "$MN_DIR/lib/plugin.sh"

# Load modules
for _mn_module_file in "$MN_DIR"/modules/*.sh; do
    [[ -f "$_mn_module_file" ]] && source "$_mn_module_file"
done
unset _mn_module_file

# Load plugins (they self-register in ALL_MODULES)
for _mn_plugin_dir in "$MN_DIR"/plugins/*/; do
    [[ -f "${_mn_plugin_dir}mn.sh" ]] && source "${_mn_plugin_dir}mn.sh"
done
unset _mn_plugin_dir

# Validate plugin dependencies — remove modules with missing required binaries
_mn_valid=""
for _mn_mod in $ALL_MODULES; do
    _mn_req="PLUGIN_${_mn_mod}_REQUIRES"
    _mn_ok=true
    if [[ -n "${!_mn_req}" ]]; then
        for _mn_dep in ${!_mn_req}; do
            command -v "$_mn_dep" &>/dev/null || { _mn_ok=false; break; }
        done
    fi
    $_mn_ok && _mn_valid="${_mn_valid:+$_mn_valid }${_mn_mod}"
done
ALL_MODULES="$_mn_valid"
unset _mn_valid _mn_mod _mn_req _mn_dep _mn_ok

# -------------------- MAIN MENU -------------------- #

show_main_menu() {
    CURRENT_MENU="main"
    USE_PAGINATION=false
    _MENU_STATUS=""
    _MENU_HIDE_ADD="false"
    MENU_ITEMS=()
    MENU_ACTIONS=()

    local sorted_mods
    sorted_mods=$(_sort_modules_by_priority)

    while IFS= read -r mod; do
        [[ -z "$mod" ]] && continue
        local label
        label=$(mod_prop "$mod" "MENU_LABEL")
        [[ -z "$label" ]] && continue
        MENU_ITEMS+=("$label")
        MENU_ACTIONS+=("show_${mod}_menu")
    done <<< "$sorted_mods"

    MENU_ITEMS+=("$T_MENU_HELP")
    MENU_ACTIONS+=("show_help")
}

# -------------------- HELP -------------------- #

show_help() {
    clear_screen
    draw_header "$T_HELP_TITLE ${CYAN}${VERSION}${NC}"

    echo ""
    echo -e "  ${BOLD}$T_HELP_USAGE${NC}"
    echo "  ───────────────────────────────────────────────"
    echo -e "  mn              $T_HELP_CMD_MAIN"

    # Dynamic module CLI args
    local sorted_mods
    sorted_mods=$(_sort_modules_by_priority)
    while IFS= read -r mod; do
        [[ -z "$mod" ]] && continue
        local cli_args label
        cli_args=$(mod_prop "$mod" "CLI_ARGS")
        label=$(mod_prop "$mod" "MENU_LABEL")
        [[ -z "$cli_args" ]] && continue
        local first_arg="${cli_args%%|*}"
        printf "  mn %-12s %s\n" "$first_arg" "$label"
    done <<< "$sorted_mods"

    echo -e "  mn plugin       $T_PLUGIN_HELP_TITLE"
    echo -e "  mn update       $T_HELP_CMD_UPDATE"
    echo -e "  mn uninstall    $T_HELP_CMD_UNINSTALL"
    echo -e "  mn help         $T_HELP_CMD_HELP"
    echo ""
    echo -e "  ${BOLD}$T_HELP_NAV${NC}"
    echo "  ───────────────────────────────────────────────"
    echo -e "  ↑/↓ $T_OR j/k    $T_HELP_NAV_ARROWS"
    echo -e "  Enter           $T_HELP_NAV_ENTER"
    echo -e "  r               $T_HELP_NAV_BACK"
    echo -e "  q               $T_HELP_NAV_QUIT"
    echo -e "  e / d / v       $T_HELP_NAV_ACTIONS"
    echo -e "  /               $T_HELP_NAV_FILTER"
    echo -e "  u / U           $T_HELP_NAV_USER"
    echo -e "  c               $T_HELP_NAV_CMDLINE"
    echo ""
    echo -e "  ${BOLD}$T_HELP_CONN${NC}"
    echo "  ───────────────────────────────────────────────"
    echo -e "  mn co <alias>          $T_HELP_CONN_DIRECT"
    echo -e "  mn co <alias> <user>   $T_HELP_CONN_USER"
    echo -e "  mn co -l               $T_HELP_CONN_LIST"
    echo ""
    echo -e "  ${BOLD}$T_HELP_FILES${NC}"
    echo "  ───────────────────────────────────────────────"
    echo "  ~/.config/mn/data/connexions.dat  Connexions SSH / Custom"
    echo "  ~/.config/mn/data/repos.dat       Repositories"
    echo "  ~/.config/mn/data/aliases.dat     Alias"
    echo "  ~/.config/mn/data/functions.dat   Functions"
    echo ""
    echo "  ~/.bash_aliases                   Bash aliases"
    echo "  ~/.bash_functions                 Bash functions"
    echo ""

    echo -e "\n${DIM}$T_PRESS_KEY_CONTINUE${NC}"
    read -n 1 -s
    hide_cursor
    LAST_MENU=""
    show_main_menu
}

# -------------------- UPDATE -------------------- #

mn_update() {
    local LATEST
    LATEST="$(curl -fsSL "${MN_CDN}/mn@latest" | grep -o '"version": *"[^"]*"' | head -1 | cut -d'"' -f4)"

    if [[ -z "$LATEST" ]]; then
        echo -e "${RED}${T_UPDATE_FAILED}${NC}"
        return 1
    fi

    if [[ "$LATEST" == "$VERSION" ]]; then
        echo -e "${GREEN}${T_UPDATE_UP_TO_DATE}${NC} (${CYAN}${VERSION}${NC})"
        return 0
    fi

    echo -e "${BLUE}${T_UPDATE_UPDATING} mn${NC} ${CYAN}${VERSION}${NC} → ${CYAN}${LATEST}${NC}\n"

    echo "$LATEST" > "$MN_DIR/VERSION"
    mkdir -p "$MN_DIR/plugins"

    # Download all files from manifest; fallback to hardcoded list if unavailable
    local manifest
    manifest=$(curl -fsSL "${MN_CDN}/mn@${LATEST}/manifest" 2>/dev/null)
    if [[ -n "$manifest" ]]; then
        while IFS= read -r file; do
            [[ -z "$file" || "$file" == VERSION ]] && continue
            local dir
            dir=$(dirname "$file")
            [[ "$dir" != "." ]] && mkdir -p "$MN_DIR/$dir"
            curl -fsSL "${MN_CDN}/mn@${LATEST}/${file}" -o "$MN_DIR/${file}" 2>/dev/null
            [[ "$file" == "mn" ]] && chmod +x "$MN_DIR/mn"
            echo -e "${GREEN}${file} ${T_UPDATED}${NC}"
        done <<< "$manifest"
        curl -fsSL "${MN_CDN}/mn@${LATEST}/manifest" -o "$MN_DIR/manifest" 2>/dev/null
    else
        # Fallback: hardcoded file list
        curl -fsSL "${MN_CDN}/mn@${LATEST}/mn" -o "$MN_DIR/mn" 2>/dev/null && chmod +x "$MN_DIR/mn"
        echo -e "${GREEN}mn ${T_UPDATED}${NC}"
        for lib in core crud dat module plugin ui; do
            curl -fsSL "${MN_CDN}/mn@${LATEST}/lib/${lib}.sh" -o "$MN_DIR/lib/${lib}.sh" 2>/dev/null
            echo -e "${GREEN}lib/${lib}.sh ${T_UPDATED}${NC}"
        done
        for mod in alias config connexions docs funcs repos; do
            curl -fsSL "${MN_CDN}/mn@${LATEST}/modules/${mod}.sh" -o "$MN_DIR/modules/${mod}.sh" 2>/dev/null
            echo -e "${GREEN}modules/${mod}.sh ${T_UPDATED}${NC}"
        done
    fi

    curl -fsSL "${MN_CDN}/mn@${LATEST}/lang/index" -o /tmp/mn_lang_index 2>/dev/null
    if [[ -s /tmp/mn_lang_index ]]; then
        while IFS=: read -r code _name; do
            [[ -z "$code" ]] && continue
            curl -fsSL "${MN_CDN}/mn@${LATEST}/lang/${code}.sh" -o "$MN_DIR/lang/${code}.sh" 2>/dev/null
            echo -e "${GREEN}lang/${code}.sh ${T_UPDATED}${NC}"
        done < /tmp/mn_lang_index
        rm -f /tmp/mn_lang_index
    fi

    # Install completions
    local bash_comp_dir zsh_comp_dir
    if [[ -w "/usr/share/bash-completion/completions" ]]; then
        bash_comp_dir="/usr/share/bash-completion/completions"
    else
        bash_comp_dir="$HOME/.local/share/bash-completion/completions"
        mkdir -p "$bash_comp_dir"
    fi
    if [[ -w "/usr/share/zsh/vendor-completions" ]]; then
        zsh_comp_dir="/usr/share/zsh/vendor-completions"
    else
        zsh_comp_dir="$HOME/.local/share/zsh/site-functions"
        mkdir -p "$zsh_comp_dir"
    fi
    [[ -f "$MN_DIR/completions/mn.bash" ]] && cp "$MN_DIR/completions/mn.bash" "$bash_comp_dir/mn" && echo -e "${GREEN}bash completion ${T_UPDATED}${NC}"
    [[ -f "$MN_DIR/completions/_mn" ]] && cp "$MN_DIR/completions/_mn" "$zsh_comp_dir/_mn" && echo -e "${GREEN}zsh completion ${T_UPDATED}${NC}"

    source "$MN_DIR/lib/core.sh"
    regenerate_bash_files

    echo -e "\n${GREEN}${T_UPDATE_DONE}${NC} ${CYAN}${LATEST}${NC}"
}

# -------------------- ENTRY POINT -------------------- #

main() {
    init_data_files

    local arg="${1:-}"

    case "$arg" in
        -v|--version)
            echo "mn $VERSION"
            return
            ;;
        help|h|-h|--help)
            show_help
            return
            ;;
        uninstall|delete)
            config_uninstall
            return
            ;;
        update|u)
            mn_update
            return
            ;;
        plugin)
            shift
            _plugin_cmd "$@"
            return
            ;;
        "")
            main_loop
            return
            ;;
    esac

    # Dynamic module routing (CRUD, menu, and plugin modules)
    for mod in $ALL_MODULES; do
        local cli_args
        cli_args=$(mod_prop "$mod" "CLI_ARGS")
        [[ -z "$cli_args" ]] && continue
        # [[ =~ ]] instead of echo | grep -qE: two forks less per module at startup
        if [[ "$arg" =~ ^(${cli_args})$ ]]; then
            shift
            _route_module "$mod" "$@"
            return
        fi
    done

    echo -e "${RED}$T_ERR_UNKNOWN: $arg${NC}"
    echo -e "${CYAN}mn help${NC} — $T_ERR_HELP_HINT"
    exit 1
}

main "$@"
