#compdef mn

# Zsh completion for mn
# Install to ~/.local/share/zsh/site-functions/_mn

_mn() {
    local -a subcommands
    subcommands=(
        'help:Show help'
        'update:Update mn to latest version'
        'uninstall:Uninstall mn'
        'plugin:Manage plugins'
        '-v:Show version'
        '--version:Show version'
    )

    # Add dynamic module and plugin commands
    local f cli_args desc first
    for f in ~/.config/mn/modules/*.sh ~/.config/mn/plugins/*/mn.sh; do
        [[ -f "$f" ]] || continue
        cli_args=$(grep -oP 'CLI_ARGS="\K[^"]*' "$f" 2>/dev/null | head -1)
        [[ -z "$cli_args" ]] && continue
        first="${cli_args%%|*}"
        # Use DESCRIPTION (plugins) or strip variable refs from MENU_LABEL (modules)
        desc=$(grep -oP 'DESCRIPTION="\K[^"]*' "$f" 2>/dev/null | head -1)
        if [[ -z "$desc" ]]; then
            desc=$(grep -oP 'MENU_LABEL="\K[^"]*' "$f" 2>/dev/null | head -1 \
                | sed 's/\${[^}]*}//g; s/\$[A-Za-z_][A-Za-z_0-9]*//g' \
                | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        fi
        subcommands+=("${first}:${desc:-$first}")
    done

    if (( CURRENT == 2 )); then
        _describe 'command' subcommands
        return
    fi

    local conn_args
    conn_args=$(grep -oP 'CLI_ARGS="\K[^"]*' ~/.config/mn/modules/connexions.sh 2>/dev/null | head -1)
    if [[ -n "$conn_args" && "|${conn_args}|" == *"|${words[2]}|"* ]]; then
        if (( CURRENT == 3 )); then
            local -a handles
            handles=(${(f)"$(awk -F':::' '!/^#/ && NF>1 {
                print $1 ":" $7
                if ($5 != "") { n = split($5, a, ","); for (i = 1; i <= n; i++) print a[i] ":" $7 }
            }' ~/.config/mn/data/connexions.dat 2>/dev/null)"})
            _describe 'connexion' handles
        elif (( CURRENT == 4 )); then
            local -a users
            users=(${(f)"$({ awk -F':::' '!/^#/ && $4 != "" { print $4 }' \
                ~/.config/mn/data/connexions.dat 2>/dev/null; echo root; echo "$USER"; } | sort -u)"})
            _describe 'utilisateur' users
        fi
        return
    fi

    if (( CURRENT >= 3 )) && [[ "${words[2]}" == plugin ]]; then
        if (( CURRENT == 3 )); then
            local -a plugin_cmds=(
                'list:List installed plugins'
                'install:Install a plugin from CDN or path'
                'update:Update an installed plugin'
                'remove:Remove an installed plugin'
                'info:Show plugin details'
            )
            _describe 'plugin command' plugin_cmds
        elif (( CURRENT == 4 )) && [[ "${words[3]}" == (remove|update|info) ]]; then
            local -a plugins d
            for d in ~/.config/mn/plugins/*/; do
                [[ -f "${d}mn.sh" ]] && plugins+=("$(basename "$d")")
            done
            _describe 'plugin' plugins
        elif (( CURRENT == 5 )) && [[ "${words[3]}" == (install|update) ]]; then
            _files
        fi
        return
    fi
}

_mn "$@"
