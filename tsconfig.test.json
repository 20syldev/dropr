{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true,
        "declaration": false,
        "sourceMap": false,
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "types": ["node"]
    },
    "include": ["test/**/*.ts", "scripts/**/*.ts"]
}
