exports[`routes > GET /manifest 1`] = `
{
  "status": 200,
  "headers": {
    "cache-control": "public, max-age=300",
    "content-length": "<length>",
    "content-type": "application/json; charset=utf-8",
    "etag": "W/<weak>"
  },
  "body": {
    "name": "dropr",
    "version": "<version>",
    "baseUrl": "https://dropr.sylvain.sh",
    "routes": [
      {
        "id": "file",
        "group": "files",
        "method": "GET",
        "path": "/{type}/{project}@{version}/{file}",
        "title": "File",
        "summary": "Serves a file of a version, with its MIME type, or lists a folder as JSON.",
        "params": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "Package type: npm, bash or config.",
            "example": "npm"
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "description": "Name of the project in this type.",
            "example": "moxon"
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "description": "Exact version (6.1.0), partial (6 or 6.1) or latest.",
            "example": "6.1.0"
          },
          {
            "name": "file",
            "in": "path",
            "required": true,
            "description": "Path of the file in the version.",
            "example": "dist/app.js"
          }
        ],
        "example": "/npm/moxon@6.1.0/package.json",
        "returns": "file",
        "notes": [
          "A path that leaves the version folder returns 404."
        ]
      },
      {
        "id": "version",
        "group": "files",
        "method": "GET",
        "path": "/{type}/{project}@{version}",
        "title": "Version",
        "summary": "Lists the files of a version, with their size.",
        "params": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "Package type: npm, bash or config.",
            "example": "npm"
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "description": "Name of the project in this type.",
            "example": "moxon"
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "description": "Exact version (6.1.0), partial (6 or 6.1) or latest.",
            "example": "6.1.0"
          }
        ],
        "example": "/npm/moxon@latest",
        "returns": "json",
        "notes": [
          "Add \`?checksums\` to get the SHA256 sums, or \`?download\` for the \`.tar.gz\` archive."
        ]
      },
      {
        "id": "checksums",
        "group": "files",
        "method": "GET",
        "path": "/{type}/{project}@{version}?checksums",
        "title": "Checksums",
        "summary": "Gives the SHA256 of each file of a version.",
        "params": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "Package type: npm, bash or config.",
            "example": "npm"
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "description": "Name of the project in this type.",
            "example": "moxon"
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "description": "Exact version (6.1.0), partial (6 or 6.1) or latest.",
            "example": "6.1.0"
          }
        ],
        "example": "/npm/moxon@6.1.0?checksums",
        "returns": "json",
        "notes": []
      },
      {
        "id": "download",
        "group": "downloads",
        "method": "GET",
        "path": "/download/{type}/{project}@{version}",
        "title": "Archive",
        "summary": "Downloads a whole version as a .tar.gz, as an attachment.",
        "params": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "Package type: npm, bash or config.",
            "example": "npm"
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "description": "Name of the project in this type.",
            "example": "moxon"
          },
          {
            "name": "version",
            "in": "path",
            "required": false,
            "description": "Exact version (6.1.0), partial (6 or 6.1) or latest.",
            "example": "6.1.0"
          }
        ],
        "example": "/download/bash/gft@1.0.6",
        "returns": "archive",
        "notes": [
          "Without a version, serves the \`latest\` version.",
          "Same as \`/{type}/{project}@{version}?download\`."
        ]
      },
      {
        "id": "downloads",
        "group": "downloads",
        "method": "GET",
        "path": "/download/{type}",
        "title": "Available archives",
        "summary": "Lists the downloadable archives, for every type or for one.",
        "params": [
          {
            "name": "type",
            "in": "path",
            "required": false,
            "description": "Package type: npm, bash or config.",
            "example": "npm"
          }
        ],
        "example": "/download/npm",
        "returns": "json",
        "notes": []
      },
      {
        "id": "project",
        "group": "packages",
        "method": "GET",
        "path": "/{type}/{project}",
        "title": "Project",
        "summary": "Lists the versions of a project, with latest.",
        "params": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "Package type: npm, bash or config.",
            "example": "npm"
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "description": "Name of the project in this type.",
            "example": "moxon"
          }
        ],
        "example": "/npm/moxon",
        "returns": "json",
        "notes": [
          "A deprecated project carries a \`deprecated\` field."
        ]
      },
      {
        "id": "changelog",
        "group": "packages",
        "method": "GET",
        "path": "/{type}/{project}/changelog",
        "title": "Changelog",
        "summary": "Gives the version history with the publication date of each.",
        "params": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "Package type: npm, bash or config.",
            "example": "npm"
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "description": "Name of the project in this type.",
            "example": "moxon"
          }
        ],
        "example": "/bash/gft/changelog",
        "returns": "json",
        "notes": []
      },
      {
        "id": "type",
        "group": "packages",
        "method": "GET",
        "path": "/{type}",
        "title": "Type",
        "summary": "Lists the projects of a type.",
        "params": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "Package type: npm, bash or config.",
            "example": "npm"
          }
        ],
        "example": "/bash",
        "returns": "json",
        "notes": []
      },
      {
        "id": "search",
        "group": "discovery",
        "method": "GET",
        "path": "/search",
        "title": "Search",
        "summary": "Searches a project by name, or lists a whole type.",
        "params": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Text searched in the names, or an exact type.",
            "example": "mox"
          }
        ],
        "example": "/search?q=mox",
        "returns": "json",
        "notes": [
          "Matches on the name come before matches on the type."
        ]
      },
      {
        "id": "index",
        "group": "discovery",
        "method": "GET",
        "path": "/",
        "title": "Index",
        "summary": "Gives every type, project and version as JSON.",
        "params": [],
        "example": "/",
        "returns": "json",
        "notes": []
      },
      {
        "id": "manifest",
        "group": "server",
        "method": "GET",
        "path": "/manifest",
        "title": "Manifest",
        "summary": "Describes every route of the server.",
        "params": [],
        "example": "/manifest",
        "returns": "json",
        "notes": []
      },
      {
        "id": "health",
        "group": "server",
        "method": "GET",
        "path": "/health",
        "title": "Health",
        "summary": "Gives the server status, its version, its uptime and the number of packages.",
        "params": [],
        "example": "/health",
        "returns": "json",
        "notes": []
      }
    ]
  }
}
`;

